<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="18dp" />
            <solid android:color="@color/secondary_button_pressed" />
            <stroke
                android:width="1dp"
                android:color="@color/secondary_button_stroke" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="18dp" />
            <solid android:color="@color/secondary_button" />
            <stroke
                android:width="1dp"
                android:color="@color/secondary_button_stroke" />
        </shape>
    </item>
</selector>
